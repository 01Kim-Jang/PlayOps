# PostgreSQL (docker compose postgres 서비스와 동일 값 권장)
PLAYOPS_ENV_FILE_PRESENT=true

POSTGRES_DB=playops
POSTGRES_USER=playops
POSTGRES_PASSWORD=playops

# PlayOps Web bootstrap login (최초 관리자 계정)
LOGIN_USERNAME=admin
LOGIN_PASSWORD=admin

# API: dev(로컬 bootRun) | prod(docker compose / docker-compose.dev.yml api)
SPRING_PROFILES_ACTIVE=dev

# 로컬 gradle bootRun 시 dev 프로필 기본값과 맞춤 (필요 시만 override)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/playops
# SPRING_DATASOURCE_USERNAME=playops
# SPRING_DATASOURCE_PASSWORD=playops

API_PORT=8080
WEB_PORT=3000
API_DEBUG_PORT=5005
WORKER_CONCURRENCY=2

# Runtime cache는 docker-compose.yml 기준 ./storage/cache 아래에 저장됩니다.
# Docker Desktop 이미지/레이어 저장소는 별도 Docker Desktop 설정에서 D 드라이브로 이동해야 합니다.
